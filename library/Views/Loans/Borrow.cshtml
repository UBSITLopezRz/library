@model BorrowForm
@{
    ViewData["Title"] = "Borrow a book";
}

<div class="library-page">

    <div class="library-header">
        <div>
            <h1 class="mb-0">Borrow a book</h1>
            <p class="mb-0">Choose a member and a book to start a loan.</p>
        </div>
    </div>

    <form asp-action="Borrow" method="post" class="library-card card-body library-form-card mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="MemberId" class="form-label">Member</label>
            <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                <option value="">(choose a member)</option>
            </select>
            <span asp-validation-for="MemberId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BookId" class="form-label">Book</label>
            <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select">
                <option value="">(choose a book)</option>
            </select>
            <span asp-validation-for="BookId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DaysAllowed" class="form-label">Days allowed</label>
            <input asp-for="DaysAllowed" class="form-control" />
            <span asp-validation-for="DaysAllowed" class="text-danger"></span>
        </div>

        <div>
            <button type="submit" class="btn btn-library-primary">Borrow</button>
            <a asp-action="Index" class="btn btn-library-edit">Cancel</a>
        </div>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}