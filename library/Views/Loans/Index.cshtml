@model List<LoanView>
@{
    ViewData["Title"] = "Loans";
}

<div class="library-page">

    <div class="library-header">
        <div>
            <h1 class="mb-0">Loans</h1>
            <p class="mb-0">@Model.Count loans, newest first</p>
        </div>
        <a asp-action="Borrow" class="btn btn-library-primary">Borrow a book</a>
    </div>

    <div class="library-card mt-3">
        <div class="table-responsive">
            <table class="table library-table align-middle">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Book</th>
                        <th>Loaned</th>
                        <th>Due</th>
                        <th>Status</th>
                        <th style="width:7rem"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model)
                    {
                        <tr>
                            <td class="book-title">@loan.MemberName</td>
                            <td>@loan.BookTitle</td>
                            <td>@(loan.LoanedOn.ToString("yyyy-MM-dd"))</td>
                            <td>@(loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd"))</td>
                            <td><span class="loan-status @(loan.Status == "Overdue" ? "loan-status-overdue" : loan.Status == "Out" ? "loan-status-out" : "loan-status-returned")">@loan.Status</span></td>
                            <td class="text-end">
                                @if (loan.ReturnedOn == null)
                                {
                                    <form asp-action="Return" asp-route-id="@loan.LoanId" method="post">
                                        <button type="submit" class="btn btn-sm btn-library-return">Return</button>
                                    </form>
                                }

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>