@model List<Book>

@{
    ViewData["Title"] = "Books";
}

<div class="library-page">

    <div class="library-header">
        <div>
            <h1 class="mb-0">Books</h1>
            <p class="mb-0">@Model.Count books</p>
        </div>

        <a asp-action="Create" class="btn btn-library-primary">
            Add a Book
        </a>
    </div>

    <div class="library-card mt-3">
        <div class="table-responsive">
            <table class="table library-table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th class="text-end">Price</th>
                        <th class="text-end" style="width: 12rem">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr>
                            <td class="book-id">@book.BookId</td>

                            <td class="book-title">@book.Title</td>

                            <td>@(book.Category ?? "—")</td>

                            <td class="text-end">
                                @(book.Price?.ToString("N2") ?? "—")
                            </td>

                            <td class="text-end">
                                <a asp-action="Edit"
                                   asp-route-id="@book.BookId"
                                   class="btn btn-sm btn-library-edit">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@book.BookId"
                                   class="btn btn-sm btn-library-delete">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>