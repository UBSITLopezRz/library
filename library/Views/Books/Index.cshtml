@model List<Book>

@{
    ViewData["Title"] = "Books";
}

<div class="library-page">

    <div class="library-header">

        <div>
            <span class="library-label">
                LIBRARY MANAGEMENT SYSTEM
            </span>

            <h1>Library Books</h1>

            <p>
                @Model.Count books currently available in the catalogue
            </p>
        </div>

        <a asp-action="Create" class="btn btn-library-primary">
            Add a Book
        </a>

    </div>


    <div class="library-stats">

        <div class="library-stat-card">

            <div class="library-stat-icon">
                BOOKS
            </div>

            <div>
                <span>Total Books</span>
                <strong>@Model.Count</strong>
            </div>

        </div>


        <div class="library-stat-card">

            <div class="library-stat-icon">
                LIST
            </div>

            <div>
                <span>Collection</span>
                <strong>Catalogue</strong>
            </div>

        </div>

    </div>


    <div class="library-card">

        <div class="library-card-header">

            <div>
                <h2>Book Catalogue</h2>

                <p>
                    Books currently recorded in the library system
                </p>
            </div>

            <span class="library-record-count">
                @Model.Count records
            </span>

        </div>


        <div class="table-responsive">

            <table class="table library-table align-middle">

                <thead>
                    <tr>

                        <th class="text-end" style="width:5rem">
                            #
                        </th>

                        <th>
                            Title
                        </th>

                        <th>
                            Category
                        </th>

                        <th class="text-end">
                            Price
                        </th>

                        <th class="text-end" style="width:12rem">
                            Actions
                        </th>

                    </tr>
                </thead>


                <tbody>

                    @foreach (var book in Model)
                    {
                        <tr>

                            <td class="text-end">
                                <span class="book-id">
                                    @book.BookId
                                </span>
                            </td>


                            <td>
                                <div class="book-title">
                                    @book.Title
                                </div>
                            </td>


                            <td>
                                <span class="book-category">
                                    @(book.Category ?? "—")
                                </span>
                            </td>


                            <td class="text-end">
                                <strong>
                                    @(book.Price?.ToString("N2") ?? "—")
                                </strong>
                            </td>


                            <td class="text-end">

                                <a asp-action="Edit"
                                   asp-route-id="@book.BookId"
                                   class="btn btn-sm btn-library-edit">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@book.BookId"
                                   class="btn btn-sm btn-library-delete">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    <div class="library-footer">
        Library Management System · Book Catalogue
    </div>

</div>