@model List<Member>

@{
    ViewData["Title"] = "Members";
}

<div class="library-page">

    <div class="library-header">
        <div>
            <h1 class="mb-0">Members</h1>
            <p class="mb-0">@Model.Count Members</p>
        </div>
        <a asp-action="Create" class="btn btn-library-primary">Register Member</a>
    </div>

    <div class="library-card mt-3">
        <table class="table library-table align-middle">
            <thead>
                <tr>
                    <th style="width:5rem">ID</th>
                    <th>Member Name</th>
                    <th>Email</th>
                    <th>Member Type</th>
                    <th class="text-end">Books out</th>
                    <th style="width:14rem">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model)
                {
                    <tr>
                        <td class="book-id">@member.MemberId</td>
                        <td class="book-title">@member.FullName</td>
                        <td>@(member.Email ?? "—")</td>
                        <td><span class="book-category">@member.MemberType</span></td>
                        <td class="text-end">@member.OpenLoans</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@member.MemberId" class="btn btn-sm btn-library-edit">Loans</a>
                            <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-library-edit">Edit</a>
                            <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-sm btn-library-delete">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>