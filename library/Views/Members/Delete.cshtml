@model Member

@{
    ViewData["Title"] = "Delete a member";
}

<div class="library-page library-danger">

    <div class="library-header">
        <div>
            <h1 class="mb-0">Delete a member</h1>
            <p class="mb-0">This action cannot be undone.</p>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-3">@ViewBag.Error</div>
    }

    <div class="library-card card-body library-delete-card mt-3">

        <p>Are you sure you want to delete this member?</p>

        <dl class="row mb-2">

            <dt class="col-4">Name</dt>
            <dd class="col-8">@Model.FullName</dd>

            <dt class="col-4">Email</dt>
            <dd class="col-8">@(Model.Email ?? "—")</dd>

            <dt class="col-4">Type</dt>
            <dd class="col-8">@Model.MemberType</dd>

        </dl>

        <form asp-action="Delete"
              asp-route-id="@Model.MemberId"
              method="post">

            <button type="submit" class="btn btn-library-delete-solid">
                Delete
            </button>

            <a asp-action="Index" class="btn btn-library-edit">
                Cancel
            </a>

        </form>

    </div>

</div>