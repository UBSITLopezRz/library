@model MemberDetails
@{
    ViewData["Title"] = Model.Member.FullName;
}

<div class="library-page">

    <div class="library-header">
        <div>
            <h1 class="mb-1">@Model.Member.FullName</h1>
            <p class="mb-0">@Model.Member.MemberType · @(Model.Member.Email ?? "no email")</p>
        </div>
        <a asp-action="Index" class="btn btn-library-edit">Back to members</a>
    </div>

    <div class="library-card mt-3">
        <div class="library-card-header">
            <h2 class="h5">Loans</h2>
            <span class="library-record-count">@Model.Loans.Count Loans</span>
        </div>

        @if (Model.Loans.Count == 0)
        {
            <p class="text-center py-5 mb-0">This member has never borrowed a book.</p>
        }
        else
        {
            <table class="table library-table align-middle">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Loaned</th>
                        <th>Returned</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model.Loans)
                    {
                        <tr>
                            <td class="book-title">@loan.BookTitle</td>
                            <td>@(loan.LoanedOn.ToString("yyyy-MM-dd"))</td>
                            <td>@(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td><span class="book-category">@loan.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>